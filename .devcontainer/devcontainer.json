{
	"name": "Cold Steel (Paradox mod manager)",
	"build": {
		"dockerfile": "Dockerfile",
		"args": {
			"USERNAME": "${localEnv:USER}"
		}
	},

	// Mount the workspace at its HOST path, not /workspaces/... -- Claude Code
	// keys session history and memory by absolute path, so this lets a session
	// started on the host continue in here and vice versa. It also keeps any
	// path the app writes into Paradox's files valid for the host-side launcher.
	"workspaceMount": "source=${localWorkspaceFolder},target=${localWorkspaceFolder},type=bind",
	"workspaceFolder": "${localWorkspaceFolder}",

	"mounts": [
		// Whole Steam install, read-only, at its host path. The manager finds
		// games by reading steamapps/libraryfolders.vdf, whose paths are host
		// paths -- mounting at the same location keeps them resolvable. Covers
		// every installed game (common/) and every subscribed Workshop mod
		// (workshop/content/<appid>/). Subscribing still happens in Steam.
		"source=${localEnv:HOME}/.local/share/Steam,target=${localEnv:HOME}/.local/share/Steam,type=bind,readonly",

		// Paradox user data, READ-WRITE: one folder per game holding mod/
		// (.mod descriptors), launcher-v2.sqlite (mod registry AND playsets),
		// dlc_load.json and logs/. This is what a mod manager edits, so it is
		// live. post-create.sh snapshots each launcher-v2.sqlite once before
		// anything can touch it -- your real playsets are in there.
		"source=${localEnv:HOME}/.local/share/Paradox Interactive,target=${localEnv:HOME}/.local/share/Paradox Interactive,type=bind",

		// The Stellaris framework project, read-only, at its host path. Its
		// tools/ (validate, deploy, vendor, logs ...) are candidates for the
		// manager's mod build function; mounted so they can be read and run
		// against, never edited from here.
		"source=${localEnv:HOME}/Desktop/dev/mods/stellaris,target=${localEnv:HOME}/Desktop/dev/mods/stellaris,type=bind,readonly",

		// Persistent Claude Code state (credentials, transcripts, memory),
		// shared with the host so sessions survive rebuilds.
		"source=${localEnv:HOME}/.claude,target=${localEnv:HOME}/.claude,type=bind",

		// Persistent GitHub CLI auth -- log in once, survives every rebuild.
		"source=${localEnv:HOME}/.config/gh,target=${localEnv:HOME}/.config/gh,type=bind",

		// Host Wayland socket, so the app under development opens a real
		// window on the desktop. Requires VS Code to have been started from
		// the Wayland session (it is when launched normally).
		"source=${localEnv:XDG_RUNTIME_DIR}/${localEnv:WAYLAND_DISPLAY},target=/run/user/1000/${localEnv:WAYLAND_DISPLAY},type=bind"
	],

	"containerEnv": {
		"CLAUDE_CONFIG_DIR": "${localEnv:HOME}/.claude",
		"STEAM_DIR": "${localEnv:HOME}/.local/share/Steam",
		"PARADOX_DATA_DIR": "${localEnv:HOME}/.local/share/Paradox Interactive",
		"STELLARIS_FRAMEWORK_DIR": "${localEnv:HOME}/Desktop/dev/mods/stellaris",
		"XDG_RUNTIME_DIR": "/run/user/1000",
		"WAYLAND_DISPLAY": "${localEnv:WAYLAND_DISPLAY}",
		// Prefer Wayland in the common toolkits.
		"GDK_BACKEND": "wayland",
		"QT_QPA_PLATFORM": "wayland",
		"SDL_VIDEODRIVER": "wayland"
	},

	"runArgs": [
		"--name=cold-steel-dev",
		// GPU for hardware-accelerated rendering of the GUI.
		"--device=/dev/dri"
	],

	"customizations": {
		"vscode": {
			"extensions": [
				"anthropic.claude-code",
				"editorconfig.editorconfig",
				"redhat.vscode-yaml",
				"ms-python.python",
				"ms-python.vscode-pylance",
				"charliermarsh.ruff",
				"ms-python.mypy-type-checker",
				"qwtel.sqlite-viewer",
				"vscode-icons-team.vscode-icons"
			],
			"settings": {
				// Game installs and Workshop content are reference data, not
				// project files -- keep them out of the watcher and search.
				"files.watcherExclude": {
					"**/.local/share/Steam/**": true,
					"**/.local/share/Paradox Interactive/**": true
				},
				"files.eol": "\n",
				"workbench.iconTheme": "vscode-icons",
				// Pylance for completion/navigation only; mypy is the one type
				// checker, so errors are not reported twice in two dialects.
				"python.languageServer": "Pylance",
				"python.analysis.typeCheckingMode": "off",
				"terminal.integrated.defaultProfile.linux": "fish"
			}
		}
	},

	"postCreateCommand": "bash .devcontainer/post-create.sh",
	"waitFor": "postCreateCommand",
	"remoteUser": "${localEnv:USER}",
	"updateRemoteUserUID": true
}
